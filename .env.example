# Copy these into Vercel → Project → Settings → Environment Variables
# Use Production + Preview (+ Development if you want)

NEXT_PUBLIC_APP_URL=https://YOUR_VERCEL_DOMAIN
NEXT_PUBLIC_SUPABASE_URL=https://wrwwfsmkqabbvffcayfy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste_anon_key
SUPABASE_SERVICE_ROLE_KEY=paste_service_role_key

NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-...
FLUTTERWAVE_SECRET_KEY=FLWSECK-...
FLUTTERWAVE_ENCRYPTION_KEY=paste_encryption_key
FLUTTERWAVE_SECRET_HASH=paste_secret_hash
