ADMIN_EMAILS=oapartment1@gmail.com

# After deploy, set Flutterwave webhook to:
# https://YOUR_VERCEL_DOMAIN/api/payments/flutterwave/webhook
# And set NEXT_PUBLIC_APP_URL to that same https domain so the checkout logo loads.